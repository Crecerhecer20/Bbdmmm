local UIS = game:GetService("UserInputService")

local dragging = nil
local dragStart


local function getTools()
	local list = {}

	for _,v in ipairs(player.Backpack:GetChildren()) do
		if v:IsA("Tool") then
			table.insert(list,v)
		end
	end

	if player.Character then
		for _,v in ipairs(player.Character:GetChildren()) do
			if v:IsA("Tool") then
				table.insert(list,v)
			end
		end
	end

	return list
end


local hotbarTools = {
	nil,nil,nil,nil,nil
}


local function equip(tool)
	if not tool then return end

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if char:FindFirstChild(tool.Name) then
		hum:UnequipTools()
	else
		hum:EquipTool(tool)
	end
end


local function refresh()
	local tools = getTools()

	for i=1,5 do
		if hotbarTools[i] then
			slots[i].Tool = hotbarTools[i]
		end

		slots[i].Name.Text =
			slots[i].Tool and slots[i].Tool.Name or ""
	end


	for _,v in ipairs(scroll:GetChildren()) do
		if v:IsA("TextButton") then
			v:Destroy()
		end
	end


	for _,tool in ipairs(tools) do
		
		local found = false

		for _,t in ipairs(hotbarTools) do
			if t == tool then
				found = true
			end
		end

		if not found then

			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0,110,0,45)
			b.BackgroundColor3 =
				Color3.fromRGB(45,45,45)

			b.Text = tool.Name
			b.TextColor3 =
				Color3.new(1,1,1)

			b.TextScaled = true
			b.ZIndex = 7
			b.Parent = scroll


			b.MouseButton1Click:Connect(function()
				equip(tool)
			end)


			b.InputBegan:Connect(function(input)

				if input.UserInputType ==
					Enum.UserInputType.MouseButton1
					or input.UserInputType ==
					Enum.UserInputType.Touch then

					dragging = tool
				end
			end)
		end
	end
end



for i=1,5 do

	slots[i].Frame.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			if dragging then

				hotbarTools[i], dragging =
					dragging, hotbarTools[i]

				refresh()

			elseif slots[i].Tool then
				equip(slots[i].Tool)
			end
		end
	end)

end



UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or input.UserInputType ==
		Enum.UserInputType.Touch then

		dragging = nil

	end
end)



