local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack,false)
end)


local gui = Instance.new("ScreenGui")
gui.Name = "CombatStyleInventory"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player.PlayerGui


local hotbar = Instance.new("Frame")
hotbar.Size = UDim2.new(0,390,0,65)
hotbar.AnchorPoint = Vector2.new(0.5,1)
hotbar.Position = UDim2.new(0.5,0,1,-10)
hotbar.BackgroundTransparency = 1
hotbar.ZIndex = 10
hotbar.Parent = gui


local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Padding = UDim.new(0,5)
layout.Parent = hotbar


local slots = {}
local hotbarTools = {nil,nil,nil,nil,nil}


local function makeSlot(i)

	local f = Instance.new("Frame")
	f.Size = UDim2.new(0,60,0,60)
	f.BackgroundColor3 = Color3.fromRGB(35,35,35)
	f.BackgroundTransparency = 0.25
	f.ZIndex = 10
	f.Parent = hotbar


	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0,8)
	c.Parent = f


	local num = Instance.new("TextLabel")
	num.Size = UDim2.new(0,20,0,20)
	num.BackgroundTransparency = 1
	num.Text = i
	num.TextColor3 = Color3.new(1,1,1)
	num.ZIndex = 11
	num.Parent = f


	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.AnchorPoint = Vector2.new(0.5,0.5)
	name.Position = UDim2.new(0.5,0,0.55,0)
	name.Size = UDim2.new(.9,0,.5,0)
	name.BackgroundTransparency = 1
	name.TextScaled = true
	name.TextWrapped = true
	name.TextColor3 = Color3.new(1,1,1)
	name.ZIndex = 11
	name.Parent = f


	slots[i] = {
		Frame=f,
		Name=name,
		Tool=nil
	}
end


for i=1,5 do
	makeSlot(i)
end


local invButton = Instance.new("TextButton")
invButton.Size = UDim2.new(0,60,0,60)
invButton.Text = "☰"
invButton.TextScaled = true
invButton.BackgroundColor3 = Color3.fromRGB(45,45,45)
invButton.ZIndex = 10
invButton.Parent = hotbar


local inv = Instance.new("Frame")
inv.Size = UDim2.new(0,380,0,260)
inv.AnchorPoint = Vector2.new(0.5,1)
inv.Position = UDim2.new(0.5,0,1,-85)
inv.BackgroundColor3 = Color3.fromRGB(25,25,25)
inv.BackgroundTransparency = 0.5
inv.Visible = false
inv.ZIndex = 1
inv.Parent = gui


local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1,-10,1,-10)
scroll.Position = UDim2.new(0,5,0,5)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 5
scroll.ZIndex = 2
scroll.Parent = inv


local grid = Instance.new("UIGridLayout")
grid.CellSize = UDim2.new(0,110,0,45)
grid.CellPadding = UDim2.new(0,5,0,5)
grid.Parent = scroll


local function tools()

	local t = {}

	for _,v in ipairs(player.Backpack:GetChildren()) do
		if v:IsA("Tool") then
			table.insert(t,v)
		end
	end

	if player.Character then
		for _,v in ipairs(player.Character:GetChildren()) do
			if v:IsA("Tool") then
				table.insert(t,v)
			end
		end
	end

	return t
end



local function equip(tool)

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if char:FindFirstChild(tool.Name) then
		hum:UnequipTools()
	else
		hum:UnequipTools()
		task.wait()
		hum:EquipTool(tool)
	end
end



local dragging = nil


local function refresh()

	for i=1,5 do
		slots[i].Tool = hotbarTools[i]
		slots[i].Name.Text =
			hotbarTools[i] and hotbarTools[i].Name or ""
	end


	for _,v in ipairs(scroll:GetChildren()) do
		if v:IsA("TextButton") then
			v:Destroy()
		end
	end


	for _,tool in ipairs(tools()) do

		local inside = false

		for _,h in ipairs(hotbarTools) do
			if h == tool then
				inside = true
			end
		end


		if not inside then

			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0,110,0,45)
			b.Text = tool.Name
			b.TextScaled = true
			b.TextWrapped = true
			b.ZIndex = 3
			b.Parent = scroll


			b.MouseButton1Click:Connect(function()
				equip(tool)
			end)


			b.InputBegan:Connect(function(input)

				if inv.Visible then
					dragging = tool
				end

			end)

		end
	end
end



for i=1,5 do

	slots[i].Frame.InputBegan:Connect(function(input)

		if input.UserInputType == Enum.UserInputType.MouseButton1 then

			if dragging then
				hotbarTools[i],dragging =
					dragging,hotbarTools[i]
				refresh()
			elseif slots[i].Tool then
				equip(slots[i].Tool)
			end

		end

	end)

end


UIS.InputEnded:Connect(function(input)

	if input.UserInputType ==
		Enum.UserInputType.MouseButton1 then

		dragging = nil
	end

end)



invButton.MouseButton1Click:Connect(function()
	inv.Visible = not inv.Visible
	refresh()
end)



player.Backpack.ChildAdded:Connect(refresh)
player.Backpack.ChildRemoved:Connect(refresh)


player.CharacterAdded:Connect(function()
	task.wait(1)
	refresh()
end)



task.wait(.5)

local start = tools()

for i=1,5 do
	hotbarTools[i] = start[i]
end

refresh()
